{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "test": "node --experimental-strip-types --test src/lib/connectors.test.ts src/lib/dog-profile.test.ts src/lib/park-pack.test.ts && pnpm run test:moderation && pnpm run test:notifications && pnpm run test:safety",
    "test:moderation": "esbuild src/routes/community-moderation.test.ts --bundle --platform=node --format=esm --external:express --external:@replit/connectors-sdk --outfile=dist/community-moderation.test.mjs && node --test dist/community-moderation.test.mjs",
    "test:notifications": "esbuild src/routes/notifications.test.ts --bundle --platform=node --format=esm --external:express --external:@replit/connectors-sdk --outfile=dist/notifications.test.mjs && node --test dist/notifications.test.mjs",
    "test:safety": "esbuild src/routes/safety.test.ts --bundle --platform=node --format=esm --external:express --external:cookie-parser --external:@replit/connectors-sdk --outfile=dist/safety.test.mjs && node --test dist/safety.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.1",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0"
  }
}
